root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 4

# The rule prints an indented blank line that Pint removes; the fixtures keep it.
[tests/Rector/CodeQuality/MultilineCallArgumentsRector/**.inc]
trim_trailing_whitespace = false
